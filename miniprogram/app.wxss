page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx;
}

.panel {
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

button.primary {
  background: #2563eb;
  color: #fff;
}

button.secondary {
  background: #eef2ff;
  color: #1e40af;
}

button.danger {
  background: #fee2e2;
  color: #991b1b;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #6b7280;
}

